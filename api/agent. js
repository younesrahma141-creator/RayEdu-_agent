export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const startTime = Date.now();
  const { lectureText, mindsetAnswer, studentLevel } = req.body;
  const apiKey = process.env.OPENROUTER_API_KEY;

  if (!apiKey) {
    return res.status(500).json({ error: 'OPENROUTER_API_KEY missing in server settings' });
  }

  const agentPrompt = `
  You are RayEdu, an autonomous AI educational and career agent competing in the Create AI Agents Championship.
  Execute these 4 autonomous agentic steps based on the student's input:

  Student Profile:
  - Academic Level: "${studentLevel}"
  - Cognitive Mindset: "${mindsetAnswer}"
  - Study Material: "${lectureText}"

  Step 1 (Cognitive Diagnosis & Weak Point Detection): Analyze the student's mindset and identify the single most complex concept in the provided text that typically causes confusion.
  Step 2 (Adaptive Micro-Learning): Summarize the text into 3 crystal-clear, bite-sized bullet points tailored to their mindset, plus explain its direct practical value in the modern job market.
  Step 3 (Smart Challenge Generator): Create 1 adaptive multiple-choice or scenario-based challenge question targeting their detected weak point, along with the correct answer and brief explanation.
  Step 4 (Career & Internship Matching): Recommend 1 exact career role/internship track that fits both their mindset and this subject matter, and explain why.

  Respond ONLY in valid JSON format with these exact keys (all values must be in clear, professional Arabic):
  {
    "mindsetType": "...",
    "weakPointDetected": "...",
    "microSummary": ["نقطة 1", "نقطة 2", "نقطة 3"],
    "jobMarketValue": "...",
    "challengeQuestion": "...",
    "challengeAnswer": "...",
    "internshipTrack": "...",
    "matchReason": "..."
  }
  `;

  try {
    const response = await fetch('https://openrouter.ai', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json',
        'HTTP-Referer': 'https://vercel.app',
        'X-Title': 'RayEdu AI Agent'
      },
      body: JSON.stringify({
        model: 'meta-llama/llama-3.3-70b-instruct:free',
        messages: [{ role: 'user', content: agentPrompt }],
        temperature: 0.3
      })
    });

    const data = await response.json();
    if (!response.ok) {
      throw new Error(data.error?.message || 'OpenRouter API connection failed');
    }

    let resultText = data.choices[0].message.content;
    resultText = resultText.replace(/```json/g, '').replace(/```/g, '').trim();
    const parsedResult = JSON.parse(resultText);

    const executionTime = ((Date.now() - startTime) / 1000).toFixed(2);
    parsedResult.metrics = {
      executionTimeSeconds: executionTime,
      estimatedTimeSavedMinutes: Math.max(15, Math.round(lectureText.split(' ').length * 0.4)),
      costPerTask: "$0.00 (Free Tier)"
    };

    res.status(200).json(parsedResult);
  } catch (error) {
    res.status(500).json({ error: 'Agent execution failed', details: error.message });
  }
}
